DATABASE_URL=postgresql://user:password@host:5432/database

# Retain raw analytics events only as long as needed for reporting.
ANALYTICS_RETENTION_DAYS=180

# Required for /stats/minute and /test-geoip admin endpoints.
ANALYTICS_ADMIN_TOKEN=replace-with-a-long-random-token

# Required to unlock the Streamlit dashboard.
DASHBOARD_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional: mark your own visits as internal traffic.
INTERNAL_TRAFFIC_SECRET=replace-with-a-long-random-token

# Optional: shown in the dashboard Privacy tab for audit visibility.
IUBENDA_PRIVACY_URL=https://www.iubenda.com/privacy-policy/your-policy-id
IUBENDA_COOKIE_POLICY_URL=https://www.iubenda.com/privacy-policy/your-policy-id/cookie-policy

# Keep disabled in production to avoid IP-derived debug traces.
GEOIP_DEBUG_LOGS=false
